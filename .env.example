# TMDB API Key - Get yours at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Database URL for Prisma (PostgreSQL for production)
DATABASE_URL="postgresql://user:password@localhost:5432/movie_series_tracker"

# NextAuth.js
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL="http://localhost:3000"

# Google OAuth (optional - enables Google sign-in)
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
